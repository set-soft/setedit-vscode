    // --- Bloques Rectangulares / Columnas ---

    // Ctrl + K, Shift + B: Activar / Desactivar modo de selección rectangular (Toggle)
    {
        "key": "ctrl+k shift+b",
        "command": "editor.action.toggleColumnSelection",
        "when": "editorTextFocus"
    },

    // Atajos directos para expandir el rectángulo con el teclado (estilo rápido)
    // Shift + Alt + Flechas (Vienen por defecto, pero puedes verificar que estén activos):
    {
        "key": "shift+alt+down",
        "command": "cursorColumnSelectDown",
        "when": "textInputFocus"
    },
    {
        "key": "shift+alt+up",
        "command": "cursorColumnSelectUp",
        "when": "textInputFocus"
    },
    {
        "key": "shift+alt+right",
        "command": "cursorColumnSelectRight",
        "when": "textInputFocus"
    },
    {
        "key": "shift+alt+left",
        "command": "cursorColumnSelectLeft",
        "when": "textInputFocus"
    },
    // --- Compilación y Depuración estilo Turbo Pascal / Borland ---
    // F9: Poner/quitar punto de interrupción (Breakpoint)
    {
        "key": "f9",
        "command": "editor.debug.action.toggleBreakpoint",
        "when": "editorTextFocus"
    },
    // Ctrl+F9: Ejecutar / Iniciar depuración
    {
        "key": "ctrl+f9",
        "command": "workbench.action.debug.start"
    },
    // F7: Paso a paso por instrucciones (Trace into / Step into)
    {
        "key": "f7",
        "command": "workbench.action.debug.stepInto",
        "when": "inDebugMode"
    },
    // F8: Paso a paso por procedimientos (Step over)
    {
        "key": "f8",
        "command": "workbench.action.debug.stepOver",
        "when": "inDebugMode"
    },
    // Ctrl+F2: Detener depuración (Program Reset)
    //{
    //    "key": "ctrl+f2",
    //    "command": "workbench.action.debug.stop",
    //    "when": "inDebugMode"
    //},
    // F6: Siguiente archivo abierto
    {
        "key": "f6",
        "command": "workbench.action.nextEditor"
    },
    // Shift + F6: Anterior archivo abierto
    {
        "key": "shift+f6",
        "command": "workbench.action.previousEditor"
    },
    // Ctrl + Q, F: Buscar (Find)
    {
        "key": "ctrl+q f",
        "command": "actions.find"
    },
    // Ctrl + Q, A: Buscar y Reemplazar (Find and Replace)
    {
        "key": "ctrl+q a",
        "command": "editor.action.startFindReplaceAction"
    },
    {
        "key": "escape",
        "command": "borlandKit.blockHide",
        "when": "editorTextFocus"
    },     


