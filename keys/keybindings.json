    // --- Bloques Rectangulares / Columnas ---

    // Ctrl + K, Shift + B: Activar / Desactivar modo de selección rectangular (Toggle)
    {
        "key": "ctrl+k shift+b",
        "command": "editor.action.toggleColumnSelection",
        "when": "editorTextFocus"
    },

    // Atajos directos para expandir el rectángulo con el teclado (estilo rápido)
    // Shift + Alt + Flechas (Vienen por defecto, pero puedes verificar que estén activos):
    {
        "key": "shift+alt+down",
        "command": "cursorColumnSelectDown",
        "when": "textInputFocus"
    },
    {
        "key": "shift+alt+up",
        "command": "cursorColumnSelectUp",
        "when": "textInputFocus"
    },
    {
        "key": "shift+alt+right",
        "command": "cursorColumnSelectRight",
        "when": "textInputFocus"
    },
    {
        "key": "shift+alt+left",
        "command": "cursorColumnSelectLeft",
        "when": "textInputFocus"
    },
    // --- Compilación y Depuración estilo Turbo Pascal / Borland ---
    // F9: Poner/quitar punto de interrupción (Breakpoint)
    {
        "key": "f9",
        "command": "editor.debug.action.toggleBreakpoint",
        "when": "editorTextFocus"
    },
    // Ctrl+F9: Ejecutar / Iniciar depuración
    {
        "key": "ctrl+f9",
        "command": "workbench.action.debug.start"
    },
    // F7: Paso a paso por instrucciones (Trace into / Step into)
    {
        "key": "f7",
        "command": "workbench.action.debug.stepInto",
        "when": "inDebugMode"
    },
    // F8: Paso a paso por procedimientos (Step over)
    {
        "key": "f8",
        "command": "workbench.action.debug.stepOver",
        "when": "inDebugMode"
    },
    // Ctrl+F2: Detener depuración (Program Reset)
    //{
    //    "key": "ctrl+f2",
    //    "command": "workbench.action.debug.stop",
    //    "when": "inDebugMode"
    //},
    // F6: Siguiente archivo abierto
    {
        "key": "f6",
        "command": "workbench.action.nextEditor"
    },
    // Shift + F6: Anterior archivo abierto
    {
        "key": "shift+f6",
        "command": "workbench.action.previousEditor"
    },
    // Ctrl + Q, F: Buscar (Find)
    {
        "key": "ctrl+q f",
        "command": "actions.find"
    },
    // Ctrl + Q, A: Buscar y Reemplazar (Find and Replace)
    {
        "key": "ctrl+q a",
        "command": "editor.action.startFindReplaceAction"
    },
    {
        "key": "escape",
        "command": "SETEdit.blockHide",
        "when": "editorTextFocus && !suggestWidgetVisible"
    },
    {// Mantener Esc para abortar el autocompletado
        "key": "escape",
        "command": "hideSuggestWidget",
        "when": "suggestWidgetVisible && textInputFocus"
    },
    {// Forzar autocompletado
        "key": "ctrl+tab",
        "command": "editor.action.triggerSuggest",
        "when": "editorHasCompletionItemProvider && textInputFocus && !editorReadonly"
    },
    // Ctrl + F12: Recargar Codium / Extensiones al instante
    {
        "key": "ctrl+f12",
        "command": "workbench.action.reloadWindow"
    },

    // Comandos Wordstar poco frecuentes
    // Ctrl + Q C: Ir al final del documento (cursorBottom)
    {
        "key": "ctrl+q c",
        "command": "cursorBottom",
        "when": "textInputFocus"
    },

    // Ctrl + Q R: Ir al inicio del documento (cursorTop)
    {
        "key": "ctrl+q r",
        "command": "cursorTop",
        "when": "textInputFocus"
    },

    // Ctrl + Q D: Fin de línea
    {
        "key": "ctrl+q d",
        "command": "cursorEnd",
        "when": "textInputFocus"
    },

    // Ctrl + Q S: Inicio de línea
    {
        "key": "ctrl+q S",
        "command": "cursorHome",
        "when": "textInputFocus"
    },

    // --- Borrado parcial de líneas ---
    // Borrar hasta el FINAL de la línea (Ctrl+Q, Y clásico de Borland / WordStar)
    {
        "key": "ctrl+q y",
        "command": "deleteAllRight",
        "when": "textInputFocus && !editorReadonly"
    },

    // Borrar hasta el PRINCIPIO de la línea
    {
        "key": "ctrl+q h",
        "command": "deleteAllLeft",
        "when": "textInputFocus && !editorReadonly"
    },

    // Saltar al delimitador complementario () {} []
    {
        "key": "ctrl+q escape",
        "command": "editor.action.jumpToBracket",
        "when": "editorTextFocus"
    },

