    // --- Rectangular blocks ---

    // Ctrl + K, Shift + B: Toggle rectangular mode
    {
        "key": "ctrl+k shift+b",
        "command": "editor.action.toggleColumnSelection",
        "when": "editorTextFocus"
    },

    // Atajos directos para expandir el rectángulo con el teclado (estilo rápido)
    // Shift + Alt + Flechas
    {
        "key": "shift+alt+down",
        "command": "cursorColumnSelectDown",
        "when": "textInputFocus"
    },
    {
        "key": "shift+alt+up",
        "command": "cursorColumnSelectUp",
        "when": "textInputFocus"
    },
    {
        "key": "shift+alt+right",
        "command": "cursorColumnSelectRight",
        "when": "textInputFocus"
    },
    {
        "key": "shift+alt+left",
        "command": "cursorColumnSelectLeft",
        "when": "textInputFocus"
    },
    // --- Debug like in Turbo Pascal / Borland ---
    // F9: Breakpoint toggle
    {
        "key": "f9",
        "command": "editor.debug.action.toggleBreakpoint",
        "when": "editorTextFocus"
    },
    // Ctrl+F9: Debug start
    {
        "key": "ctrl+f9",
        "command": "workbench.action.debug.start"
    },
    // F7: Trace into / Step into
    {
        "key": "f7",
        "command": "workbench.action.debug.stepInto",
        "when": "inDebugMode"
    },
    // F8: Step over
    {
        "key": "f8",
        "command": "workbench.action.debug.stepOver",
        "when": "inDebugMode"
    },
    // Ctrl+F2: Detener depuración (Program Reset)
    //{
    //    "key": "ctrl+f2",
    //    "command": "workbench.action.debug.stop",
    //    "when": "inDebugMode"
    //},

    // Window navigation
    // F6: Next open file
    {
        "key": "f6",
        "command": "workbench.action.nextEditor"
    },
    // Shift + F6: Previous open file
    {
        "key": "shift+f6",
        "command": "workbench.action.previousEditor"
    },

    // Ctrl + Q, F: Find
    {
        "key": "ctrl+q f",
        "command": "actions.find"
    },
    // Ctrl + Q, A: Find and Replace
    {
        "key": "ctrl+q a",
        "command": "editor.action.startFindReplaceAction"
    },

    // Quick selection hide
    {
        "key": "escape",
        "command": "SETEdit.blockHide",
        "when": "editorTextFocus && !suggestWidgetVisible"
    },
    {// But keep ESC to abort autocompletion
        "key": "escape",
        "command": "hideSuggestWidget",
        "when": "suggestWidgetVisible && textInputFocus"
    },

    {// Aucomplete (forced)
        "key": "ctrl+tab",
        "command": "editor.action.triggerSuggest",
        "when": "editorHasCompletionItemProvider && textInputFocus && !editorReadonly"
    },

    // Ctrl + F12: Editor reset to load the extensions again
    {
        "key": "ctrl+f12",
        "command": "workbench.action.reloadWindow"
    },

    // Other Wordstar commands
    // Ctrl + Q C: End of document
    {
        "key": "ctrl+q c",
        "command": "cursorBottom",
        "when": "textInputFocus"
    },

    // Ctrl + Q R: Start of document
    {
        "key": "ctrl+q r",
        "command": "cursorTop",
        "when": "textInputFocus"
    },

    // Ctrl + Q D: End of line
    {
        "key": "ctrl+q d",
        "command": "cursorEnd",
        "when": "textInputFocus"
    },

    // Ctrl + Q S: Start of line
    {
        "key": "ctrl+q S",
        "command": "cursorHome",
        "when": "textInputFocus"
    },

    // Partial line erase
    // Erase to the end (Ctrl+Q, Y classic Borland / WordStar)
    {
        "key": "ctrl+q y",
        "command": "deleteAllRight",
        "when": "textInputFocus && !editorReadonly"
    },
    // Erase to the start
    {
        "key": "ctrl+q h",
        "command": "deleteAllLeft",
        "when": "textInputFocus && !editorReadonly"
    },

    // Jump to pair () {} []
    {
        "key": "ctrl+q escape",
        "command": "editor.action.jumpToBracket",
        "when": "editorTextFocus"
    },

