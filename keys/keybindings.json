[
    // --- File and Windows (Borland CUA) ---
    {
        "key": "f2",
        "command": "workbench.action.files.save"
    },
    {
        "key": "f3",
        "command": "workbench.action.files.openFile"
    },
    {
        "key": "alt+0",
        "command": "workbench.action.quickOpen"
    },
    {
        "key": "alt+f3",
        "command": "workbench.action.closeActiveEditor"
    },

    // --- Code editing ---
    // Delete line (Ctrl+Y classic)
    {
        "key": "ctrl+y",
        "command": "editor.action.deleteLines",
        "when": "textInputFocus && !editorReadonly"
    },
    // Alt + Backspace: Undo (Borland classic)
    {
        "key": "alt+backspace",
        "command": "undo",
        "when": "textInputFocus && !editorReadonly"
    },
    // Shift + Alt + Backspace: Redo (Borland classic)
    {
        "key": "shift+alt+backspace",
        "command": "redo",
        "when": "textInputFocus && !editorReadonly"
    },

    // Ctrl + PgUp: Document start (cursorTop)
    {
        "key": "ctrl+pageup",
        "command": "cursorTop",
        "when": "textInputFocus"
    },

    // Ctrl + PgDn: Document end (cursorBottom)
    {
        "key": "ctrl+pagedown",
        "command": "cursorBottom",
        "when": "textInputFocus"
    },

    // Ctrl + Shift + PgUp: Select to document start
    {
        "key": "ctrl+shift+pageup",
        "command": "cursorTopSelect",
        "when": "textInputFocus"
    },

    // Ctrl + Shift + PgDn: Select to document end
    {
        "key": "ctrl+shift+pagedown",
        "command": "cursorBottomSelect",
        "when": "textInputFocus"
    },

    // Markers using Numbered Bookmarks by Alessandro Fragnani
    // --- MARK 1 ---
    {
        "key": "ctrl+k 1",
        "command": "numberedBookmarks.toggleBookmark1",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+q 1",
        "command": "numberedBookmarks.jumpToBookmark1",
        "when": "editorTextFocus"
    },

