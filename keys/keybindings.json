[
    // --- Archivos y Ventanas (Borland CUA) ---
    {
        "key": "f2",
        "command": "workbench.action.files.save"
    },
    {
        "key": "f3",
        "command": "workbench.action.files.openFile"
    },
    {
        "key": "alt+0",
        "command": "workbench.action.quickOpen"
    },    
    {
        "key": "alt+f3",
        "command": "workbench.action.closeActiveEditor"
    },

    // --- Edición de Código ---
    // Borrar línea actual (Ctrl+Y clásico)
    {
        "key": "ctrl+y",
        "command": "editor.action.deleteLines",
        "when": "textInputFocus && !editorReadonly"
    },
    // Alt + Backspace: Undo (Borland clásico)
    {
        "key": "alt+backspace",
        "command": "undo",
        "when": "textInputFocus && !editorReadonly"
    },
    // Shift + Alt + Backspace: Redo (Borland clásico)
    {
        "key": "shift+alt+backspace",
        "command": "redo",
        "when": "textInputFocus && !editorReadonly"
    },

    // Ctrl + PgUp: Ir al inicio del documento (cursorTop)
    {
        "key": "ctrl+pageup",
        "command": "cursorTop",
        "when": "textInputFocus"
    },

    // Ctrl + PgDn: Ir al final del documento (cursorBottom)
    {
        "key": "ctrl+pagedown",
        "command": "cursorBottom",
        "when": "textInputFocus"
    },

    // Ctrl + Shift + PgUp: Seleccionar hasta el inicio del documento
    {
        "key": "ctrl+shift+pageup",
        "command": "cursorTopSelect",
        "when": "textInputFocus"
    },

    // Ctrl + Shift + PgDn: Seleccionar hasta el final del documento
    {
        "key": "ctrl+shift+pagedown",
        "command": "cursorBottomSelect",
        "when": "textInputFocus"
    },

    // Marcadores usando Numbered Bookmarks de Alessandro Fragnani
    // --- MARCADOR 1 ---
    {
        "key": "ctrl+k 1",
        "command": "numberedBookmarks.toggleBookmark1",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+q 1",
        "command": "numberedBookmarks.jumpToBookmark1",
        "when": "editorTextFocus"
    },

