{
  "name": "SETEdit",
  "displayName": "SETEdit",
  "description": "SETEdit/RHIDE (Borland C/Turbo C) style keybindings",
  "version": "1.0.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "SETEdit",
      "properties": {
        "SETEdit.excludeFromWrapping": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "workbench.action.debug.",
            "editor.debug.action."
          ],
          "description": "Command prefixes to be excluded from macro recording."
        },
        "SETEdit.persistentSelection": {
          "type": "boolean",
          "default": true,
          "description": "The mouse and keyboard selections remains while typing."
        },
        "SETEdit.dialogDirectory": {
          "type": "string",
          "enum": [
            "document",
            "workspace",
            "last"
          ],
          "default": "document",
          "enumDescriptions": [
            "Directory of the file under edition",
            "Project root",
            "Last path used in the dialog"
          ],
          "description": "Starting path for the Ctrl+W / Ctrl+R (block read/write) dialog. Skipped if missing."
        },
        "SETEdit.browserCommand": {
          "type": "string",
          "default": "",
          "description": "Command used to open URLs and img:/pdf: (i.e.: \"firefox\" o \"firefox --new-tab\"). Uses the system default when empty."
        },
        "SETEdit.showTabs": {
          "type": "boolean",
          "default": true,
          "description": "Make the tabs visible, using a border around them"
        },
        "SETEdit.foldButtons": {
          "type": "boolean",
          "default": true,
          "description": "Show icons to un/fold (in editor tabs)"
        }
      }
    },
    "commands": [
      {
        "command": "SETEdit.installKeybindings",
        "title": "Install recordable keybindings",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.macroStart",
        "title": "Record macro",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.macroStop",
        "title": "Stop macro recording",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.macroPlay",
        "title": "Replay recorded macro",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.macroPlayN",
        "title": "Replay recorded macro N times",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.exec",
        "title": "Execute a recordable command (wrapper)",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.replaceNext",
        "title": "Replace next",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockBegin",
        "title": "Block start (selection)",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockEnd",
        "title": "Block end (selection)",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockHide",
        "title": "Hide block (selection)",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockSelect",
        "title": "Convert block into selection",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockCopy",
        "title": "Copy block and paste it",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockMove",
        "title": "Move block",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockDelete",
        "title": "Delete block",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockWrite",
        "title": "Write block to disk",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockRead",
        "title": "Read block from disk",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockClipCopy",
        "title": "Copy block to clipboard",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockClipCut",
        "title": "Cut block to clipboard",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.symbolsInFile",
        "title": "Look for symbol in file (word under cursor)",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.symbolsInWorkspace",
        "title": "Look for symbol in project (word under cursor)",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.cursorViewTop",
        "title": "Jump to first visible line",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.cursorViewBottom",
        "title": "Jump to last visible line",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.cursorViewTopSelect",
        "title": "Select to first visible line",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.cursorViewBottomSelect",
        "title": "Select to last visible line",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.deleteWhitespaceAhead",
        "title": "Erase spaces and/or words at the right",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockReplacePaste",
        "title": "Replace from clipboard",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockPaste",
        "title": "Paste and mark as block",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockGotoBegin",
        "title": "Jump to block start",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockGotoEnd",
        "title": "Jump to block end",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockMarkLine",
        "title": "Select line as block",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockMarkWord",
        "title": "Select word as block",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.openFileUnderCursor",
        "title": "Open URL or file under cursor",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockIndent",
        "title": "Indent block one space",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockOutdent",
        "title": "Outdent block one level",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockIndentLevel",
        "title": "Indent block one level",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockOutdentLevel",
        "title": "Outdent block one space",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockComment",
        "title": "Comment block",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockUncomment",
        "title": "Uncomment block",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockPrefix",
        "title": "Arbitrary indent",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockUppercase",
        "title": "UPPERCASE block",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockLowercase",
        "title": "lowercase block",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockView",
        "title": "Show block",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.quitWithConfirmation",
        "title": "Exit with save and confirmation",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.foldAll",
        "title": "Fold all",
        "icon": "$(fold-down)"
      },
      {
        "command": "SETEdit.unfoldAll",
        "title": "Unfold all",
        "icon": "$(fold-up)"
      },
      {
        "command": "SETEdit.foldLevel",
        "title": "Fold N levels...",
        "icon": "$(fold)"
      }
    ],
    "keybindings": [
      {
        "key": "shift+f10",
        "command": "SETEdit.macroStart"
      },
      {
        "key": "alt+f10",
        "command": "SETEdit.macroStop"
      },
      {
        "key": "ctrl+f10",
        "command": "SETEdit.macroPlay"
      },
      {
        "key": "ctrl+l",
        "command": "SETEdit.replaceNext",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k b",
        "command": "SETEdit.blockBegin",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k k",
        "command": "SETEdit.blockEnd",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k h",
        "command": "SETEdit.blockHide",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k c",
        "command": "SETEdit.blockCopy",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k v",
        "command": "SETEdit.blockMove",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k y",
        "command": "SETEdit.blockDelete",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k w",
        "command": "SETEdit.blockWrite",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k r",
        "command": "SETEdit.blockRead",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+w",
        "command": "SETEdit.blockWrite",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+r",
        "command": "SETEdit.blockRead",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+delete",
        "command": "SETEdit.blockDelete",
        "when": "editorTextFocus && SETEdit.hasBlock"
      },
      {
        "key": "ctrl+insert",
        "command": "SETEdit.blockClipCopy",
        "when": "editorTextFocus && SETEdit.hasBlock"
      },
      {
        "key": "shift+delete",
        "command": "SETEdit.blockClipCut",
        "when": "editorTextFocus && SETEdit.hasBlock"
      },
      {
        "key": "ctrl+c",
        "command": "SETEdit.blockClipCopy",
        "when": "editorTextFocus && !editorHasSelection && SETEdit.hasBlock"
      },
      {
        "key": "ctrl+x",
        "command": "SETEdit.blockClipCut",
        "when": "editorTextFocus && !editorHasSelection && SETEdit.hasBlock"
      },
      {
        "key": "alt+f2",
        "command": "SETEdit.symbolsInFile",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+f2",
        "command": "SETEdit.symbolsInWorkspace",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+j",
        "command": "workbench.action.gotoLine"
      },
      {
        "key": "ctrl+shift+insert",
        "command": "SETEdit.blockReplacePaste",
        "when": "editorTextFocus && SETEdit.hasBlock"
      },
      {
        "key": "shift+insert",
        "command": "SETEdit.blockPaste",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+q b",
        "command": "SETEdit.blockGotoBegin",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+q k",
        "command": "SETEdit.blockGotoEnd",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k l",
        "command": "SETEdit.blockMarkLine",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k t",
        "command": "SETEdit.blockMarkWord",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+enter",
        "command": "SETEdit.openFileUnderCursor",
        "when": "editorTextFocus && !suggestWidgetVisible"
      },
      {
        "key": "ctrl+home",
        "command": "SETEdit.cursorViewTop",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+q e",
        "command": "SETEdit.cursorViewTop",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+end",
        "command": "SETEdit.cursorViewBottom",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+q x",
        "command": "SETEdit.cursorViewBottom",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+shift+home",
        "command": "SETEdit.cursorViewTopSelect",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+shift+end",
        "command": "SETEdit.cursorViewBottomSelect",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+t",
        "command": "SETEdit.deleteWhitespaceAhead",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+k i",
        "command": "SETEdit.blockIndent",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k u",
        "command": "SETEdit.blockOutdent",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k tab",
        "command": "SETEdit.blockIndentLevel",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k shift+tab",
        "command": "SETEdit.blockOutdentLevel",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k p",
        "command": "SETEdit.blockPrefix",
        "when": "editorTextFocus && SETEdit.hasBlock"
      },
      {
        "key": "ctrl+k m",
        "command": "SETEdit.blockUppercase",
        "when": "editorTextFocus && SETEdit.hasBlock"
      },
      {
        "key": "ctrl+k o",
        "command": "SETEdit.blockLowercase",
        "when": "editorTextFocus && SETEdit.hasBlock"
      },
      {
        "key": "alt+x",
        "command": "SETEdit.quitWithConfirmation"
      }
    ],
    "configurationDefaults": {
      "editor.find.seedSearchStringFromSelection": "never",
      "editor.renderWhitespace": "trailing",
      "files.trimTrailingWhitespace": true,
      "files.insertFinalNewline": true,
      "files.trimFinalNewlines": true
    },
    "colors": [
      {
        "id": "SETEdit.tabOutline1",
        "description": "First color for the tabs border.",
        "defaults": {
          "dark": "#34b934aa",
          "light": "#2aa72aaa",
          "highContrast": "#00ff00",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "SETEdit.tabOutline2",
        "description": "Second color for the tabs border.",
        "defaults": {
          "dark": "#b93434aa",
          "light": "#a72a2aaa",
          "highContrast": "#ff0000",
          "highContrastLight": "#000000"
        }
      }
    ],
    "submenus": [
      {
        "id": "SETEdit.tools",
        "label": "SETEdit tools"
      },
      {
        "id": "SETEdit.indentMenu",
        "label": "Indent block"
      },
      {
        "id": "SETEdit.commentMenu",
        "label": "Un/comment block"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "SETEdit.foldAll",
          "when": "editorTextFocus",
          "group": "navigation@1"
        },
        {
          "command": "SETEdit.unfoldAll",
          "when": "editorTextFocus",
          "group": "navigation@1"
        },
        {
          "command": "SETEdit.foldLevel",
          "when": "editorTextFocus",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "submenu": "SETEdit.tools",
          "group": "9_SETEdit",
          "when": "editorTextFocus"
        }
      ],
      "SETEdit.tools": [
        {
          "submenu": "SETEdit.indentMenu",
          "group": "1_block@1"
        },
        {
          "submenu": "SETEdit.commentMenu",
          "group": "1_block@2"
        }
      ],
      "SETEdit.indentMenu": [
        {
          "command": "SETEdit.blockIndent",
          "group": "1@1"
        },
        {
          "command": "SETEdit.blockOutdent",
          "group": "1@2"
        },
        {
          "command": "SETEdit.blockIndentLevel",
          "group": "1@3"
        },
        {
          "command": "SETEdit.blockOutdentLevel",
          "group": "1@4"
        },
        {
          "command": "SETEdit.blockPrefix",
          "group": "1@5"
        }
      ],
      "SETEdit.commentMenu": [
        {
          "command": "SETEdit.blockComment",
          "group": "1@1"
        },
        {
          "command": "SETEdit.blockUncomment",
          "group": "1@2"
        }
      ]
    }
  }
}
