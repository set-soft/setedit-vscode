{
  "name": "SETEdit",
  "displayName": "SETEdit",
  "description": "SETEdit/RHIDE (Borland C/Turbo C) style keybindings",
  "version": "1.0.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "SETEdit",
      "properties": {
        "SETEdit.excludeFromWrapping": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "workbench.action.debug.",
            "editor.debug.action."
          ],
          "description": "Prefijos de comandos de tu keybindings.json que NO se envuelven (no se graban en macros)."
        },
        "SETEdit.persistentSelection": {
          "type": "boolean",
          "default": true,
          "description": "Las selecciones hechas con mouse o teclado quedan como bloque persistente (no se reemplazan al escribir ni se pierden al mover el cursor)."
        },
        "SETEdit.dialogDirectory": {
          "type": "string",
          "enum": [
            "document",
            "workspace",
            "last"
          ],
          "default": "document",
          "enumDescriptions": [
            "Carpeta del archivo que estás editando",
            "Raíz del proyecto abierto",
            "Última carpeta usada en estos diálogos"
          ],
          "description": "Carpeta inicial de los diálogos de Ctrl+W / Ctrl+R (escribir/leer bloque). Si la carpeta elegida no sirve (no existe o es la de configuración del editor), se prueba con las otras."
        },
        "SETEdit.browserCommand": {
          "type": "string",
          "default": "",
          "description": "Comando para abrir URLs y archivos img:/pdf: (ej: \"firefox\" o \"firefox --new-tab\"). Vacío = navegador/visor por defecto del sistema."
        },
        "SETEdit.showTabs": {
          "type": "boolean",
          "default": true,
          "description": "Marca con un recuadro los caracteres de tabulación del texto."
        }
      }
    },
    "commands": [
      {
        "command": "SETEdit.installKeybindings",
        "title": "Instalar atajos grabables",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.macroStart",
        "title": "Grabar macro",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.macroStop",
        "title": "Detener grabación",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.macroPlay",
        "title": "Reproducir macro",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.macroPlayN",
        "title": "Reproducir macro N veces",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.exec",
        "title": "Ejecutar comando (grabable)",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.replaceNext",
        "title": "Reemplazar siguiente",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockBegin",
        "title": "Inicio de bloque",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockEnd",
        "title": "Fin de bloque",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockHide",
        "title": "Ocultar bloque",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockSelect",
        "title": "Convertir bloque en selección",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockCopy",
        "title": "Copiar bloque al cursor",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockMove",
        "title": "Mover bloque al cursor",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockDelete",
        "title": "Borrar bloque",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockWrite",
        "title": "Escribir bloque a archivo",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockRead",
        "title": "Leer archivo en el cursor",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockClipCopy",
        "title": "Copiar bloque al portapapeles",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockClipCut",
        "title": "Cortar bloque al portapapeles",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.symbolsInFile",
        "title": "Símbolos del archivo (palabra bajo el cursor)",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.symbolsInWorkspace",
        "title": "Símbolos del proyecto (palabra bajo el cursor)",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.cursorViewTop",
        "title": "Ir a la primera línea visible",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.cursorViewBottom",
        "title": "Ir a la última línea visible",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.cursorViewTopSelect",
        "title": "Seleccionar hasta la primera línea visible",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.cursorViewBottomSelect",
        "title": "Seleccionar hasta la última línea visible",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.deleteWhitespaceAhead",
        "title": "Borrar espacios o palabra a la derecha",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockReplacePaste",
        "title": "Reemplazar bloque por el portapapeles",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockPaste",
        "title": "Pegar y marcar como bloque",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockGotoBegin",
        "title": "Ir al principio del bloque",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockGotoEnd",
        "title": "Ir al final del bloque",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockMarkLine",
        "title": "Marcar línea como bloque",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockMarkWord",
        "title": "Marcar palabra como bloque",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.openFileUnderCursor",
        "title": "Abrir archivo o URL bajo el cursor",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockIndent",
        "title": "Indentar bloque (un espacio)",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockOutdent",
        "title": "Desindentar bloque (un espacio)",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockIndentLevel",
        "title": "Indentar bloque (un nivel)",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockOutdentLevel",
        "title": "Desindentar bloque (un nivel)",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockComment",
        "title": "Comentar bloque",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockUncomment",
        "title": "Descomentar bloque",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockPrefix",
        "title": "Anteponer texto a cada línea del bloque",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockUppercase",
        "title": "Bloque a MAYÚSCULAS",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockLowercase",
        "title": "Bloque a minúsculas",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.blockView",
        "title": "Mostrar bloque",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.quitWithConfirmation",
        "title": "Salir con confirmación de grabación",
        "category": "SETEdit"
      },
      {
        "command": "SETEdit.foldAll",
        "title": "Plegar todo",
        "icon": "$(fold-down)"
      },
      {
        "command": "SETEdit.unfoldAll",
        "title": "Desplegar todo",
        "icon": "$(fold-up)"
      },
      {
        "command": "SETEdit.foldLevel",
        "title": "Plegar por nivel...",
        "icon": "$(fold)"
      }
    ],
    "keybindings": [
      {
        "key": "shift+f10",
        "command": "SETEdit.macroStart"
      },
      {
        "key": "alt+f10",
        "command": "SETEdit.macroStop"
      },
      {
        "key": "ctrl+f10",
        "command": "SETEdit.macroPlay"
      },
      {
        "key": "ctrl+l",
        "command": "SETEdit.replaceNext",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k b",
        "command": "SETEdit.blockBegin",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k k",
        "command": "SETEdit.blockEnd",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k h",
        "command": "SETEdit.blockHide",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k c",
        "command": "SETEdit.blockCopy",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k v",
        "command": "SETEdit.blockMove",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k y",
        "command": "SETEdit.blockDelete",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k w",
        "command": "SETEdit.blockWrite",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k r",
        "command": "SETEdit.blockRead",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+w",
        "command": "SETEdit.blockWrite",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+r",
        "command": "SETEdit.blockRead",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+delete",
        "command": "SETEdit.blockDelete",
        "when": "editorTextFocus && SETEdit.hasBlock"
      },
      {
        "key": "ctrl+insert",
        "command": "SETEdit.blockClipCopy",
        "when": "editorTextFocus && SETEdit.hasBlock"
      },
      {
        "key": "shift+delete",
        "command": "SETEdit.blockClipCut",
        "when": "editorTextFocus && SETEdit.hasBlock"
      },
      {
        "key": "ctrl+c",
        "command": "SETEdit.blockClipCopy",
        "when": "editorTextFocus && !editorHasSelection && SETEdit.hasBlock"
      },
      {
        "key": "ctrl+x",
        "command": "SETEdit.blockClipCut",
        "when": "editorTextFocus && !editorHasSelection && SETEdit.hasBlock"
      },
      {
        "key": "alt+f2",
        "command": "SETEdit.symbolsInFile",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+f2",
        "command": "SETEdit.symbolsInWorkspace",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+j",
        "command": "workbench.action.gotoLine"
      },
      {
        "key": "ctrl+shift+insert",
        "command": "SETEdit.blockReplacePaste",
        "when": "editorTextFocus && SETEdit.hasBlock"
      },
      {
        "key": "shift+insert",
        "command": "SETEdit.blockPaste",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+q b",
        "command": "SETEdit.blockGotoBegin",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+q k",
        "command": "SETEdit.blockGotoEnd",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k l",
        "command": "SETEdit.blockMarkLine",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k t",
        "command": "SETEdit.blockMarkWord",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+enter",
        "command": "SETEdit.openFileUnderCursor",
        "when": "editorTextFocus && !suggestWidgetVisible"
      },
      {
        "key": "ctrl+home",
        "command": "SETEdit.cursorViewTop",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+q e",
        "command": "SETEdit.cursorViewTop",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+end",
        "command": "SETEdit.cursorViewBottom",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+q x",
        "command": "SETEdit.cursorViewBottom",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+shift+home",
        "command": "SETEdit.cursorViewTopSelect",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+shift+end",
        "command": "SETEdit.cursorViewBottomSelect",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+t",
        "command": "SETEdit.deleteWhitespaceAhead",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+k i",
        "command": "SETEdit.blockIndent",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k u",
        "command": "SETEdit.blockOutdent",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k tab",
        "command": "SETEdit.blockIndentLevel",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k shift+tab",
        "command": "SETEdit.blockOutdentLevel",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+k p",
        "command": "SETEdit.blockPrefix",
        "when": "editorTextFocus && SETEdit.hasBlock"
      },
      {
        "key": "ctrl+k m",
        "command": "SETEdit.blockUppercase",
        "when": "editorTextFocus && SETEdit.hasBlock"
      },
      {
        "key": "ctrl+k o",
        "command": "SETEdit.blockLowercase",
        "when": "editorTextFocus && SETEdit.hasBlock"
      },
      {
        "key": "alt+x",
        "command": "SETEdit.quitWithConfirmation"
      }
    ],
    "configurationDefaults": {
      "editor.find.seedSearchStringFromSelection": "never",
      "editor.renderWhitespace": "trailing",
      "files.trimTrailingWhitespace": true,
      "files.insertFinalNewline": true,
      "files.trimFinalNewlines": true
    },
    "colors": [
      {
        "id": "SETEdit.tabOutline1",
        "description": "Color del recuadro con que marca los tabuladores.",
        "defaults": {
          "dark": "#34b934aa",
          "light": "#2aa72aaa",
          "highContrast": "#00ff00",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "SETEdit.tabOutline2",
        "description": "Color del recuadro con que marca los tabuladores.",
        "defaults": {
          "dark": "#b93434aa",
          "light": "#a72a2aaa",
          "highContrast": "#ff0000",
          "highContrastLight": "#000000"
        }
      }
    ],
    "submenus": [
      {
        "id": "SETEdit.tools",
        "label": "Herramientas"
      },
      {
        "id": "SETEdit.indentMenu",
        "label": "Des/indentar bloque"
      },
      {
        "id": "SETEdit.commentMenu",
        "label": "Des/comentar bloque"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "SETEdit.foldAll",
          "when": "editorTextFocus",
          "group": "navigation@1"
        },
        {
          "command": "SETEdit.unfoldAll",
          "when": "editorTextFocus",
          "group": "navigation@1"
        },
        {
          "command": "SETEdit.foldLevel",
          "when": "editorTextFocus",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "submenu": "SETEdit.tools",
          "group": "9_SETEdit",
          "when": "editorTextFocus"
        }
      ],
      "SETEdit.tools": [
        {
          "submenu": "SETEdit.indentMenu",
          "group": "1_block@1"
        },
        {
          "submenu": "SETEdit.commentMenu",
          "group": "1_block@2"
        }
      ],
      "SETEdit.indentMenu": [
        {
          "command": "SETEdit.blockIndent",
          "group": "1@1"
        },
        {
          "command": "SETEdit.blockOutdent",
          "group": "1@2"
        },
        {
          "command": "SETEdit.blockIndentLevel",
          "group": "1@3"
        },
        {
          "command": "SETEdit.blockOutdentLevel",
          "group": "1@4"
        },
        {
          "command": "SETEdit.blockPrefix",
          "group": "1@5git"
        }
      ],
      "SETEdit.commentMenu": [
        {
          "command": "SETEdit.blockComment",
          "group": "1@1"
        },
        {
          "command": "SETEdit.blockUncomment",
          "group": "1@2"
        }
      ]
    }
  }
}
